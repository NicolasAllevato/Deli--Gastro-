// App Next.js (OpenNext) en la cuenta Opsyn-La gambeta Dely. Ver docs/MIGRACION_CLOUDFLARE.md.
// Secretos con `npx wrangler secret put <NOMBRE>` (nunca acá). Las NEXT_PUBLIC_* se hornean en el build:
// tienen que estar en el entorno al correr `npm run cf:deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opsyn-dely",
  "account_id": "e7351dd776e005da826ba6f2a5aae4c1",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "opsyn-dely" }],
  "workers_dev": true,
  "routes": [
    { "pattern": "opsyndely.la-gambeta.com", "custom_domain": true },
    { "pattern": "www.opsyndely.la-gambeta.com", "custom_domain": true }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://opsyndely.la-gambeta.com",
    // Base de Better Auth: los links de recuperación SIEMPRE salen de este dominio.
    "BETTER_AUTH_URL": "https://opsyndely.la-gambeta.com",
    // Migración D1 (docs/migracion-supabase-d1.md). supabase = comportamiento actual.
    // Cambiar a dual/d1 SOLO con OK explícito del usuario.
    "DATA_BACKEND": "supabase"
  },
  // Base D1 de la migración. Solo la usa src/lib/data/db.ts y solo si DATA_BACKEND != supabase.
  "d1_databases": [
    { "binding": "DB", "database_name": "deli-gastro", "database_id": "8e293f66-d614-4519-8514-be4dd6a3ac44" }
  ],
  // Cloudflare Email Sending (resumen diario). Requiere onboardear la-gambeta.com: docs/EMAIL_CLOUDFLARE.md.
  "send_email": [{ "name": "EMAIL" }],
  // Workers Paid: 30 s de CPU por request (Free = 10 ms → error 1102). Ver memoria aprendizaje-error-1102.
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true }
}
