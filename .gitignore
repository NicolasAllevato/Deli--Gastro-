# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# n8n workflows (may contain sensitive webhook URLs)
n8n_workflows/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# e2e / agentes temporales
e2e-*.js
e2e-*.mjs
e2e-*.png
e2e-screenshots/
screenshot_pages.js

# Python / build artifacts
__pycache__/
dist/
.venv/

.vercel

.vercel

# clon local de github/spec-kit (herramienta externa, repo propio)
spec-kit/

# Playwright
/test-results/
/playwright-report/
/blob-report/

# Workers de Cloudflare
/workers/*/node_modules/
/workers/*/.wrangler/
# Archivos temporales de secretos para `wrangler secret bulk`
/workers/*/secrets*.json
/workers/*/secretos*.json
/workers/*/.dev.vars*

# Credenciales de prueba (privado)
/usuarios-de-prueba.txt

# compilación de npm run demo:rapido
/.next-demo/

# OpenNext (Cloudflare)
.open-next/
.wrangler/

# Simulador de clientes del bot (informes y base local)
/reports/

# Roadmap local (mod de Claude Code)
ROADMAP.md

# Worktrees temporales de agentes
.claude/worktrees/

# Datos reales de producción para el simulador (solo lectura; se regeneran con exportar-datos-reales.ts)
/scripts/simulador/datos-reales/
.videos-meta/
