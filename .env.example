# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Secret Keys (No exponer en el cliente)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Clave para guardar el PIN de los repartidores cifrado y que el admin pueda verlo (AES-256-GCM).
# 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Solo servidor (secreto del Worker). Si falta, los PIN funcionan pero no se pueden volver a ver.
COURIER_PIN_KEY=

# n8n Webhook URLs
N8N_WEBHOOK_URL_CHATBOT="https://your-n8n-instance.com/webhook/chatbot-ai"
N8N_WEBHOOK_URL_ORDERS="https://your-n8n-instance.com/webhook/order-sync"
N8N_WEBHOOK_URL_REVIEWS="https://your-n8n-instance.com/webhook/review-escalation"
N8N_DISPATCHER_URL="https://your-n8n-instance.com/webhook/deli-dispatcher"

# Maps Configuration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Cloudflare (cuenta — usado por wrangler CLI para R2/Workers)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-account-api-token"

# Cloudflare R2 (imágenes de productos — S3-compatible, se genera manualmente
# en el dashboard: R2 → Manage R2 API Tokens → Create API Token)
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="deli-gastro-productos"
R2_PUBLIC_BASE_URL="https://<bucket-id>.r2.dev"
# Camino preferido para /api/upload: Worker `uploads` (binding R2, sin R2 API keys).
# Si ambas están seteadas, se ignoran las R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY.
UPLOADS_WORKER_URL="https://uploads.<subdominio>.workers.dev"
UPLOADS_WORKER_TOKEN="mismo-valor-que-el-secret-UPLOADS_TOKEN-del-worker"

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# WhatsApp Cloud API (opcional: también se cargan desde /admin/whatsapp y quedan en
# la tabla integration_secrets; si definís la variable, el entorno tiene prioridad)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
# Embedded Signup (botón "Conectar con Facebook"): App ID y Config ID de la app de Meta
WHATSAPP_APP_ID=""
WHATSAPP_CONFIG_ID=""

# OpenAI (agente de pedidos): también se puede cargar desde /admin/agente
OPENAI_API_KEY=""

# Cron de encuestas: lo dispara el Worker de Cloudflare workers/encuestas-cron cada 15 min con
# "Authorization: Bearer <CRON_SECRET>" (no Vercel Cron: en Hobby solo admite crons diarios).
# Sin esta variable el endpoint rechaza todo. El Worker usa el mismo valor.
CRON_SECRET=""

# Mercado Pago (cobro digital, Checkout Pro). Las tres hacen falta: sin alguna, la opción "Mercado Pago"
# no se ofrece. Empezá con credenciales de PRUEBA (TEST-...) de una aplicación de Mercado Pago Developers.
# MP_WEBHOOK_SECRET es la "clave secreta" del webhook (Tus integraciones → Webhooks), NO el access token.
# PUBLIC_URL tiene que ser https y accesible desde internet: de ahí salen las URLs de retorno y del webhook.
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
PUBLIC_URL=""

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resumen diario por mail (Resend). Sin estas dos variables solo se envia por WhatsApp.
RESEND_API_KEY=
RESUMEN_EMAIL_FROM=

# OpenWA (WhatsApp por QR, solo pruebas). Con WHATSAPP_PROVIDER=openwa las respuestas de
# Conversaciones salen por OpenWA; sin estas variables se usa Meta. Ver src/lib/whatsapp/openwa.ts.
WHATSAPP_PROVIDER=
OPENWA_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=
# Secreto con el que se registra el webhook en OpenWA (firma X-OpenWA-Signature).
OPENWA_WEBHOOK_SECRET=

# Panel de control OPSYN: copia de las aceptaciones de Términos/Privacidad.
# Sin estas variables no se envía nada. Ver src/lib/legal/panel.ts.
PANEL_CONTROL_URL=
PANEL_CONTROL_CLIENTE_ID=
PANEL_CONTROL_TOKEN=

# Solo para `npm run seed:admin` (modo Supabase/demo): contraseña del admin que crea el script.
# No tiene valor por defecto; el script falla si falta. Con D1 los usuarios se crean en /admin/usuarios.
# ADMIN_PASSWORD=

# Dueño principal del panel (usuarios del personal). En producción va como secreto o variable del Worker
# (`wrangler secret put SUPER_OWNER_EMAIL --name opsyn-dely`); acá es solo un recordatorio.
# El usuario con este email es el único que crea dueños o edita a otros dueños, y nadie lo bloquea ni lo degrada.
# Vacío = modo seguro: ningún dueño edita a otro dueño ni crea dueños, y se loguea una advertencia.
# Tiene que ser el email de un usuario que ya sea dueño. Ver docs/runbook-corte-d1.md.
SUPER_OWNER_EMAIL=
