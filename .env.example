# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Secret Keys (No exponer en el cliente)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# n8n Webhook URLs
N8N_WEBHOOK_URL_CHATBOT="https://your-n8n-instance.com/webhook/chatbot-ai"
N8N_WEBHOOK_URL_ORDERS="https://your-n8n-instance.com/webhook/order-sync"
N8N_WEBHOOK_URL_REVIEWS="https://your-n8n-instance.com/webhook/review-escalation"
N8N_DISPATCHER_URL="https://your-n8n-instance.com/webhook/deli-dispatcher"

# Maps Configuration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Cloudflare (cuenta — usado por wrangler CLI para R2/Workers)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-account-api-token"

# Cloudflare R2 (imágenes de productos — S3-compatible, se genera manualmente
# en el dashboard: R2 → Manage R2 API Tokens → Create API Token)
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="deli-gastro-productos"
R2_PUBLIC_BASE_URL="https://<bucket-id>.r2.dev"

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# WhatsApp Cloud API (opcional: también se cargan desde /admin/whatsapp y quedan en
# la tabla integration_secrets; si definís la variable, el entorno tiene prioridad)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""

# OpenAI (agente de pedidos): también se puede cargar desde /admin/agente
OPENAI_API_KEY=""

# Cron de encuestas: llamar cada 10-15 min a GET /api/cron/surveys con el encabezado
# "Authorization: Bearer <CRON_SECRET>" (cron externo, o Vercel Cron en plan Pro: en Hobby
# solo admite crons diarios, por eso no está en vercel.json). Sin esta variable rechaza todo.
CRON_SECRET=""

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
